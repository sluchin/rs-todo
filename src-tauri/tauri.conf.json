{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rstodo",
  "version": "0.1.0",
  "identifier": "com.app.rstodo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "rstodo",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Task management app with daily work output",
    "longDescription": "A task management app built with Tauri (Rust + React) for Windows / Linux / macOS. Features Microsoft Todo-like functionality with daily work output tracking.",
    "copyright": "Copyright © 2026 Tetsuya Higashi",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
